# GEMINI_API_KEY: Optional AI Studio injected secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected by AI Studio.
APP_URL="MY_APP_URL"

# ==============================================================================
# EMIE CLINIC — REQUIRED SERVER-SIDE ENVIRONMENT VARIABLES
# Never expose these values in frontend code or VITE_* variables.
# ==============================================================================

# Airtable Personal Access Token (scopes: data.records:read, data.records:write, schema.bases:read)
AIRTABLE_ACCESS_TOKEN=""

# Airtable Base ID for the dedicated "EMIE CLINIC MANAGEMENT SYSTEM" base (starts with "app...")
AIRTABLE_BASE_ID=""

# Make.com Custom Webhook URL for booking & appointment notifications
MAKE_BOOKING_WEBHOOK_URL=""

# Cryptographic secret (minimum 32 random chars) used to sign HttpOnly session cookies
SESSION_SECRET=""

# Initial Super Admin credentials (or use ADMIN_SETUP_TOKEN for protected first-time setup)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Direction EMIE CLINIC"

# Protected setup token required to bootstrap the first Super Admin via /api/auth/setup
ADMIN_SETUP_TOKEN=""
